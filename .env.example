JWT_SECRET=remplace_moi_par_une_longue_chaine_aleatoire
PORT=3000

# Astrocomptoir — paiements réels via PayPal (voir server.js, section
# "ASTROCOMPTOIR"). Sans ces deux variables, la page fonctionne mais les
# recharges/retraits réels sont désactivés ("paypal_not_configured").
# À obtenir sur developer.paypal.com avec un compte PayPal Business,
# en créant une "App" (REST API).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" pour tester avec de faux comptes PayPal, "live" pour du vrai argent.
PAYPAL_MODE=sandbox

# Signalement de bug (onglet "🐛 Signaler un bug" de la box de Tchat en
# partie, voir server.js route /api/report-bug). Sans ces variables, le
# formulaire reste utilisable mais renvoie "mail_not_configured" au lieu
# d'envoyer réellement l'e-mail. Exemple avec Gmail : SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USER=une_adresse_gmail, SMTP_PASS=un "mot de passe
# d'application" généré depuis les paramètres de sécurité Google (pas le mot
# de passe du compte).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Destinataire des signalements — laisser vide pour utiliser loris.croce2@gmail.com par défaut.
BUG_REPORT_EMAIL=
