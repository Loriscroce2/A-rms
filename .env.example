JWT_SECRET=remplace_moi_par_une_longue_chaine_aleatoire
PORT=3000

# Paiements réels via PayPal — utilisés à la fois par l'Astrocomptoir
# (recharge/retrait du portefeuille réel) ET par la Boutique (achat de lots
# de pièces). Sans ces variables, ces pages fonctionnent mais les paiements
# réels sont désactivés ("paypal_not_configured").
# À obtenir sur developer.paypal.com, connecté avec LE compte PayPal qui
# doit recevoir l'argent (idéalement un compte Business), section
# "Apps & Credentials" → créer une App en mode LIVE → copier le Client ID
# et le Secret ci-dessous. Tout l'argent payé par les joueurs atterrit sur
# le compte PayPal propriétaire de ces identifiants — il n'y a rien d'autre
# à configurer dans le code pour choisir le destinataire.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" pour tester avec de faux comptes PayPal, "live" pour du vrai argent.
PAYPAL_MODE=sandbox

# Paiement direct par carte bancaire (Stripe Checkout) — utilisé UNIQUEMENT
# par la Boutique (achat de lots de pièces), en alternative à PayPal.
# Sans cette variable, le bouton "💳 Carte bancaire" reste affiché mais
# désactivé ("stripe_not_configured").
# À obtenir sur dashboard.stripe.com, connecté avec LE compte Stripe qui
# doit recevoir l'argent (le compte doit être activé : SIRET, IBAN et pièce
# d'identité renseignés). Section "Développeurs" → "Clés API" → copier la
# "Clé secrète" (elle commence par sk_test_... en mode test, sk_live_... une
# fois le compte activé). Aucune autre configuration n'est nécessaire : les
# paiements sont automatiquement virés par Stripe vers l'IBAN du compte,
# tous les quelques jours — jamais de portefeuille intermédiaire.
STRIPE_SECRET_KEY=

# Signalement de bug (onglet "🐛 Signaler un bug" de la box de Tchat en
# partie, voir server.js route /api/report-bug). Sans ces variables, le
# formulaire reste utilisable mais renvoie "mail_not_configured" au lieu
# d'envoyer réellement l'e-mail. Exemple avec Gmail : SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USER=une_adresse_gmail, SMTP_PASS=un "mot de passe
# d'application" généré depuis les paramètres de sécurité Google (pas le mot
# de passe du compte).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Destinataire des signalements — laisser vide pour utiliser loris.croce2@gmail.com par défaut.
BUG_REPORT_EMAIL=
